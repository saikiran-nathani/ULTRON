# ULTRON environment. Copy to `.env` and edit; `.env` is gitignored.
#
# Two systems read from here:
#   TRAINWATCH_*  -> the monitoring half (src/trainwatch/, folded in from
#                    what used to be the separate Monitoring/ repo)
#   HF_* / PYTORCH_* -> the training half
#
# trainwatch loads this file itself (its config.py has an 8-line .env reader,
# deliberately dependency-free), so anything below is picked up by both the
# trainer and `trainwatch serve` as long as they run from the repo root.

# ── monitoring ──────────────────────────────────────────────────────────────
# THE critical one. The trainer and the dashboard must point at the SAME file,
# and the server must run on the machine doing the training — the TUF, not the
# Mac. Put it on /data so it is not on the 512 GB OS SSD.
TRAINWATCH_DB=/data/ultron/trainwatch.db
TRAINWATCH_HEARTBEAT=/data/ultron/heartbeat
TRAINWATCH_BLOB_DIR=/data/ultron/blobs

# Telemetry older than this is dropped by the server's hourly reaper. 0 = never
# (and then nothing bounds the database except `trainwatch prune`).
TRAINWATCH_KEEP_DAYS=30

# Where the dashboard listens. Bound to the tailnet, guarded by ADR-0003's Host
# allowlist — never expose this with `tailscale funnel`.
TRAINWATCH_PORT=8730

# 0.0.0.0 is safe here ONLY because Tailscale is the network boundary — the
# port is exposed on the tailnet, not the public internet. Do not port-forward.
TRAINWATCH_HOST=0.0.0.0

# For a machine that is a CLIENT of the hub rather than its host — the Mac
# talking to the hub on the TUF. Leave unset on the host itself.
# TRAINWATCH_HUB=https://asus-tuf.tailXXXX.ts.net

# Host header allowlist (ADR-0003 C1). localhost and this machine's tailnet
# identity are auto-detected from `tailscale status`; add anything else here.
# A request from an unlisted hostname gets a 421, which looks like a bug the
# first time it happens.
TRAINWATCH_ALLOWED_HOSTS=

# Optional bearer token on writes. Empty = open on the tailnet. NOTE: this
# gates writes only, not reads — see ADR-0003's "C6's limitation".
TRAINWATCH_TOKEN=

# ── alerts ──────────────────────────────────────────────────────────────────
# ntfy topic. Treat this as a credential: anyone who knows the string can read
# your alerts. Leave empty to disable notifications entirely.
# Generate one with:
#   python -c "import secrets; print('trainwatch-' + secrets.token_urlsafe(16))"
TRAINWATCH_NTFY_TOPIC=
TRAINWATCH_NTFY_SERVER=https://ntfy.sh

# Only needed if you self-host ntfy behind auth.
# TRAINWATCH_NTFY_TOKEN=

# ── watchdog thresholds ─────────────────────────────────────────────────────
# Tune once you have a baseline; the defaults are deliberately loose so the
# first run does not page you about normal behaviour.
TRAINWATCH_GRAD_NORM_CEIL=100.0
TRAINWATCH_ENTROPY_FLOOR=0.15
TRAINWATCH_STEP_TIME_DRIFT=1.5
TRAINWATCH_HEARTBEAT_TIMEOUT=900

# Which sinks TrainMonitor.log() fans out to. `store` is the dashboard; add
# `tensorboard` and/or `wandb` if you want them. Each extra sink is another
# thing that can fail at import, so start with just store.
TRAINWATCH_SINKS=store

# Only read when `tensorboard` is in TRAINWATCH_SINKS.
TRAINWATCH_TENSORBOARD_DIR=runs

# ── training (ULTRON) ───────────────────────────────────────────────────────
# Set HF_HOME BEFORE the first download or the cache lands on the OS SSD.
HF_HOME=/data/hf
HF_DATASETS_CACHE=/data/hf/datasets
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
WANDB_PROJECT=ultron
