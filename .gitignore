# --- OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# --- python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
venv/
.venv/
env/
.ruff_cache/
# unsloth codegens patched trainer sources into cwd on import; 3.4 MB, regenerable
unsloth_compiled_cache/
.ipynb_checkpoints/

# --- the resolved environment, not the spec (recreate with pip install -r requirements.txt)
requirements.lock.txt

# --- model weights and quantized artefacts: large, and regenerable from adapter + base
*.safetensors
*.gguf
*.bin
*.pt
*.ckpt
outputs/
adapters/
merged/
hf_cache/
runs/

# --- data is append-only and large; it lives on disk, never in git.
# The directory shapes are tracked via .gitkeep, the contents never are.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# --- adapters are tens of MB and regenerable from config + data; merged models never.
checkpoints/*
!checkpoints/.gitkeep

# --- scratch only, never canonical
notebooks/*
!notebooks/.gitkeep

# --- run artefacts
wandb/
*.log

# --- trainwatch runtime state (folded in from Monitoring/) -------------------
# The SQLite store, its WAL, heartbeats and hub blobs are machine-local and
# per-box: the trainer and `scripts/trainwatch serve` share one DB file on the
# machine doing the training. Never committed.
var/
*.db
*.db-wal
*.db-shm
heartbeat*
logs/
.env
.env.local
*.key

# --- trainwatch dashboard (React/Vite workspace at dashboard/) ---------------
dashboard/node_modules/
dashboard/dist/
dashboard/tsconfig.tsbuildinfo
# NOTE: src/trainwatch/server/static/ IS committed on purpose -- it is the built
# dashboard, so the training box never needs Node installed.

# --- tooling caches ---------------------------------------------------------
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# NOT ignored, deliberately:
#   configs/     -- configs/ IS the lab notebook. A config that is not committed did not happen.
#   results/     -- written by hand, one markdown file per phase. Your future self reads only this.
#   data/tasks/  -- eval fixtures are .jsonl and MUST be versioned. A blanket data/**/*.jsonl
#                   rule would silently swallow them, so the data rules above are scoped to
#                   raw/ interim/ processed/ only.
#   src/trainwatch/server/static/  -- the BUILT dashboard. Committed so the
#                   training box never needs Node; CI-less now, so if you change
#                   dashboard/ you must re-run `npm run build` and commit the diff.
#   dashboard/      -- the dashboard SOURCE. node_modules and dist are ignored
#                   above; everything else is versioned.
